# CHCN — environment variable template (PLACEHOLDERS ONLY — no real secrets)
# Copy to .env and fill in. Never commit the real .env. Never put the service
# role key in any client-side JavaScript.

# --- Supabase (optional backend; see docs/deployment/DEPLOYMENT.md) ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_ANON_KEY            # safe for client use
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY   # SERVER-SIDE ONLY
SUPABASE_DB_URL=postgresql://USER:PASSWORD@HOST:5432/postgres

# --- App ---
APP_BASE_URL=https://YOUR-DOMAIN
FOUNDER_EMAIL=founder@YOUR-DOMAIN          # bootstrap only; NOT a client auth check
